# ===== 模型 API Key =====
# 至少配置一个；可同时配置多个，启动时通过 model 选择器指定用哪个
ANTHROPIC_API_KEY=替换为你的真实 key
# OPENAI_API_KEY=...
# DEEPSEEK_API_KEY=...

# ===== OpenAI 可选配置 =====
# 自定义 API 地址（建议使用 HTTPS；本地网关 localhost/127.0.0.1 可用 HTTP）
# 支持第三方兼容服务，如 OneAPI、云服务商 API 代理等
# OPENAI_BASE_URL=https://your-api-proxy.com/v1

# ===== 可选配置 =====
# 覆盖默认 model，形如 "anthropic/claude-sonnet-4-5" / "openai/gpt-4o" / "deepseek/deepseek-chat"
# 不设置则用 pi-coding-agent 的默认 model
# AICOWORK_DEFAULT_MODEL=deepseek/deepseek-chat

# orchestrator 监听端口（默认 3001）
# PORT=3001

# 监听地址（默认 127.0.0.1，仅本机访问）
# 公网/容器部署时设为 0.0.0.0，但必须同时设置 AICOWORK_AUTH_TOKEN，否则任何人都能调用你的 Agent
# AICOWORK_HOST=127.0.0.1

# WS 鉴权 token：前端连接 /ws 需带 ?token=xxx
# 生成建议：node -e "console.log(require('crypto').randomUUID())"
# 公网部署必填；本机部署可留空（仅允许 127.0.0.1 连接）
# AICOWORK_AUTH_TOKEN=
